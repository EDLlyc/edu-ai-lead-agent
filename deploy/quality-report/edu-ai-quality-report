#!/bin/sh
# Daily read-only production quality report (see backend/app/quality_report_main.py).
# Runs a one-off container of the pinned report image; no service is restarted or modified.
set -eu
IMAGE="offline.local/edu-ai/edu-ai-lead-agent-backend@sha256:528bd43002703e02c41c315a3be4d3ece0e39c48ee6019c53f069d8b239b214e"
DAY="${1:-$(TZ=Asia/Shanghai date +%F)}"
OUT=/opt/edu-ai-lead-agent/reports/quality
mkdir -p "$OUT"
chmod 700 "$OUT"
cd /opt/edu-ai-lead-agent
for format in markdown json; do
  ext=$([ "$format" = markdown ] && echo md || echo json)
  APP_IMAGE="$IMAGE" docker compose -p edu-ai-lead-agent --env-file .env --env-file .release.env \
    run --rm --no-deps -T --entrypoint python acquisition-api \
    -m app.quality_report_main --date "$DAY" --output "$format" > "$OUT/$DAY.$ext.tmp"
  mv "$OUT/$DAY.$ext.tmp" "$OUT/$DAY.$ext"
done
echo "quality report written: $OUT/$DAY.md"
