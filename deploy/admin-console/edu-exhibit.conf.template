# 展台 (visitor display) entry, read-only, behind the 运营后台 login.
# https://__SHOW_HOST__/  <->  https://__ADMIN_HOST__/admin/
#
# Both hosts must sit under one registrable domain and the API must run with
# ADMIN_SESSION_COOKIE_DOMAIN=<that domain>, so the login cookie reaches this host. Every request
# below is first checked against /api/v1/admin/auth/me; without a valid session a page request is
# sent to the console login and an API/asset request gets 401.
#
# Only the static build and two GET routes of the adapter are exposed. The operator routes
# (operator/session, news-reviews, human-picks) are NOT listed, so they answer 404 here:
# `human-picks` runs the real pipeline and pushes to the formal WeCom group, and stays on the
# local operator connector.
# Replace __SHOW_HOST__, __ADMIN_HOST__ and the certificate paths, then `nginx -t`.

server {
    listen 80;
    server_name __SHOW_HOST__;
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name __SHOW_HOST__;
    server_tokens off;

    ssl_certificate /etc/nginx/ssl/__SHOW_HOST__.crt;
    ssl_certificate_key /etc/nginx/ssl/__SHOW_HOST__.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:edu_exhibit_ssl:10m;

    root /var/www/edu-ai-exhibit;
    include /etc/nginx/snippets/edu-exhibit-headers.conf;

    # Session check. The browser's Cookie header is forwarded to the API unchanged.
    location = /_edu_auth {
        internal;
        proxy_pass http://127.0.0.1:8000/api/v1/admin/auth/me;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    location @to_login {
        add_header Cache-Control "no-store" always;
        return 302 https://__ADMIN_HOST__/admin/;
    }

    location @unauthorized {
        add_header Cache-Control "no-store" always;
        default_type application/json;
        return 401 '{"error":{"code":"admin_login_required"}}';
    }

    # Hashed build files: safe to cache for a year (the page itself stays no-store below).
    location /assets/ {
        auth_request /_edu_auth;
        error_page 401 = @unauthorized;
        try_files $uri =404;
        include /etc/nginx/snippets/edu-exhibit-headers.conf;
        add_header Cache-Control "private, max-age=31536000, immutable" always;
    }

    # Fixed pictures of the hall page (not hashed): cache a day, per browser only.
    location ~* \.(jpg|jpeg|png|webp|svg|ico)$ {
        auth_request /_edu_auth;
        error_page 401 = @unauthorized;
        try_files $uri =404;
        include /etc/nginx/snippets/edu-exhibit-headers.conf;
        add_header Cache-Control "private, max-age=86400" always;
    }

    # Pages.
    location / {
        auth_request /_edu_auth;
        error_page 401 = @to_login;
        try_files $uri $uri/ /index.html;
        include /etc/nginx/snippets/edu-exhibit-headers.conf;
        add_header Cache-Control "no-store" always;
    }

    location = /api/v1/visitor-display/snapshot {
        limit_except GET { deny all; }
        auth_request /_edu_auth;
        error_page 401 = @unauthorized;
        proxy_pass http://127.0.0.1:18089;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
        gzip on;
        gzip_types application/json;   # 470 KB -> ~100 KB; only this route, not the admin API
        add_header Cache-Control "no-store" always;
    }

    # Opaque, signed media references only.
    location ~ "^/api/v1/visitor-display/assets/v[a-z]1_[A-Za-z0-9_-]{43}$" {
        limit_except GET { deny all; }
        auth_request /_edu_auth;
        error_page 401 = @unauthorized;
        proxy_pass http://127.0.0.1:18089;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
    }

    location /api/ {
        return 404;
    }
}
