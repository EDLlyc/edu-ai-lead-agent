# 运营后台 public entry (https://__DOMAIN__/admin/).
#
# Only the built console (dist-admin) and /api/v1/admin/* are reachable. Every other API route has
# no login and stays on loopback: anything not listed here is 404. Replace __DOMAIN__ (and the
# certificate paths), copy edu-admin-headers.conf to /etc/nginx/snippets/, then `nginx -t`.

limit_req_zone $binary_remote_addr zone=edu_admin_login:10m rate=10r/m;

server {
    listen 80;
    server_name __DOMAIN__;
    server_tokens off;

    # HTTP-01 challenge if the certificate comes from certbot / Let's Encrypt.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name __DOMAIN__;
    server_tokens off;

    ssl_certificate /etc/nginx/ssl/__DOMAIN__.crt;
    ssl_certificate_key /etc/nginx/ssl/__DOMAIN__.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:edu_admin_ssl:10m;

    # Optional: only the office network may open the console.
    # allow __OFFICE_IP__;
    # deny all;

    root /var/www/edu-ai-admin;
    client_max_body_size 64k;
    include /etc/nginx/snippets/edu-admin-headers.conf;

    location = / {
        return 302 /admin/;
    }

    # Hashed build files: cache for a year.
    location /assets/ {
        try_files $uri =404;
        include /etc/nginx/snippets/edu-admin-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # The single-page console; every /admin/<section> loads the same page.
    location /admin/ {
        try_files $uri /admin/index.html;
        include /etc/nginx/snippets/edu-admin-headers.conf;
        add_header Cache-Control "no-store" always;
    }

    # Slow down password guessing on top of the account lockout.
    location = /api/v1/admin/auth/login {
        limit_req zone=edu_admin_login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /api/v1/admin/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # A 新闻源 preview fetches robots.txt, a list page and three articles.
        proxy_read_timeout 150s;
    }

    location / {
        return 404;
    }
}
