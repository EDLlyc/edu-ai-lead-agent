# Application
APP_ENV=development
APP_HOST=127.0.0.1
# If this port changes, update VITE_API_BASE_URL to the same host port.
APP_PORT=8000
BUSINESS_TIMEZONE=Asia/Shanghai
VITE_API_BASE_URL=http://127.0.0.1:8000

# PostgreSQL / pgvector (local development only)
POSTGRES_DB=edu_ai
POSTGRES_USER=edu_ai
POSTGRES_PASSWORD=edu_ai_local_change_me
# If this port changes, update DATABASE_URL to the same host port.
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://edu_ai:edu_ai_local_change_me@127.0.0.1:5432/edu_ai

# MinIO / S3-compatible object storage (local development only)
MINIO_ROOT_USER=edu_ai_minio
MINIO_ROOT_PASSWORD=edu_ai_minio_local_change_me
# If the API port changes, update MINIO_ENDPOINT to the same host port.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET=edu-ai-materials
MINIO_SECURE=false
MINIO_ACCESS_KEY=edu_ai_minio
MINIO_SECRET_KEY=edu_ai_minio_local_change_me

# Authoritative-source acquisition (server default: daily 06:30 Asia/Shanghai)
ACQUISITION_SCHEDULE_HOUR=6
ACQUISITION_SCHEDULE_MINUTE=30
ACQUISITION_CATCHUP_HOURS=12
ACQUISITION_POLL_SECONDS=2
ACQUISITION_WORKER_CONCURRENCY=4
ACQUISITION_LEASE_SECONDS=120
ACQUISITION_HEARTBEAT_SECONDS=30
ACQUISITION_MAX_ATTEMPTS=3
ACQUISITION_MAX_RESPONSE_BYTES=5242880
ACQUISITION_CONNECT_TIMEOUT_SECONDS=10
ACQUISITION_READ_TIMEOUT_SECONDS=30
ACQUISITION_TOTAL_TIMEOUT_SECONDS=45
ACQUISITION_MAX_REDIRECTS=3
ACQUISITION_USER_AGENT=EduAILeadAgent/0.1 (+https://github.com/EDLlyc/edu-ai-lead-agent)
ACQUISITION_FIRST_RUN_ITEM_LIMIT=20
ACQUISITION_DAILY_ITEM_LIMIT=10
ACQUISITION_FIRST_RUN_SCAN_LIMIT=100
ACQUISITION_DAILY_SCAN_LIMIT=50
ACQUISITION_VERSION=acquisition-v1

# Factual governance — disabled by default until its worker workflow is enabled.
GOVERNANCE_ENABLED=false
GOVERNANCE_SCHEDULER_ENABLED=false
GOVERNANCE_WORKER_ENABLED=false
GOVERNANCE_POLL_SECONDS=5
GOVERNANCE_WORKER_CONCURRENCY=2
GOVERNANCE_LEASE_SECONDS=300
GOVERNANCE_HEARTBEAT_SECONDS=60
GOVERNANCE_MAX_ATTEMPTS=3
GOVERNANCE_RETRY_BASE_SECONDS=30
GOVERNANCE_PIPELINE_VERSION=governance-v1
GOVERNANCE_NORMALIZATION_VERSION=normalization-v1
GOVERNANCE_PASSAGE_SCHEMA_VERSION=passage-v1
GOVERNANCE_TAXONOMY_VERSION=ai-factual-taxonomy-v1
GOVERNANCE_PROMPT_VERSION=factual-analysis-v1
GOVERNANCE_ANALYSIS_SCHEMA_VERSION=factual-analysis-schema-v1
GOVERNANCE_EMBEDDING_INPUT_VERSION=embedding-input-v1
GOVERNANCE_SIMILARITY_RULE_VERSION=semantic-v1
GOVERNANCE_EVENT_ASSIGNMENT_VERSION=event-assignment-v1
# Official LangGraph PostgreSQL saver uses psycopg, not the SQLAlchemy asyncpg URL.
GOVERNANCE_CHECKPOINT_DATABASE_URL=postgresql://edu_ai:edu_ai_local_change_me@127.0.0.1:5432/edu_ai

# Factual-analysis provider: disabled (no worker calls), fake (offline acceptance), or zhipu.
# Keep real Zhipu credentials only in local .env or the deployment secret store.
AI_PROVIDER_MODE=disabled
AI_PLATFORM_BASE_URL=
AI_PLATFORM_API_KEY=
AI_CHAT_MODEL=glm-5.2
AI_EMBEDDING_MODEL=embedding-3
AI_EMBEDDING_DIMENSIONS=2048
AI_CONNECT_TIMEOUT_SECONDS=10
AI_READ_TIMEOUT_SECONDS=120
AI_TOTAL_TIMEOUT_SECONDS=150
AI_PROVIDER_CONCURRENCY=2
AI_MAX_ATTEMPTS=3
AI_MAX_VALIDATION_CORRECTIONS=1
AI_MAX_INPUT_CHARACTERS=40000
AI_MAX_OUTPUT_TOKENS=4096
AI_MAX_TOKENS_PER_RUN=200000
AI_MAX_TOKENS_PER_DAY=1000000
AI_MAX_COST_UNITS_PER_RUN=100000
AI_MAX_COST_UNITS_PER_DAY=500000
