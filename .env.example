# Application
APP_ENV=development
APP_HOST=127.0.0.1
# If this port changes, update VITE_API_BASE_URL to the same host port.
APP_PORT=8000
# Exact comma-separated browser origins only; never use `*` for this no-auth intranet app.
APP_BROWSER_ORIGINS=http://127.0.0.1:5173
BUSINESS_TIMEZONE=Asia/Shanghai
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_IP_ASSET_HUB_ENABLED=false

# PostgreSQL / pgvector (local development only)
POSTGRES_DB=edu_ai
POSTGRES_USER=edu_ai
POSTGRES_PASSWORD=edu_ai_local_change_me
# If this port changes, update DATABASE_URL to the same host port.
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://edu_ai:edu_ai_local_change_me@127.0.0.1:5432/edu_ai

# MinIO / S3-compatible object storage (local development only)
MINIO_ROOT_USER=edu_ai_minio
MINIO_ROOT_PASSWORD=edu_ai_minio_local_change_me
# If the API port changes, update MINIO_ENDPOINT to the same host port.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET=edu-ai-materials
MINIO_SECURE=false
MINIO_ACCESS_KEY=edu_ai_minio
MINIO_SECRET_KEY=edu_ai_minio_local_change_me

# Authoritative-source acquisition (server default: daily 06:30 Asia/Shanghai)
ACQUISITION_SCHEDULE_HOUR=6
ACQUISITION_SCHEDULE_MINUTE=30
ACQUISITION_CATCHUP_HOURS=12
ACQUISITION_POLL_SECONDS=2
ACQUISITION_WORKER_CONCURRENCY=4
ACQUISITION_LEASE_SECONDS=120
ACQUISITION_HEARTBEAT_SECONDS=30
ACQUISITION_MAX_ATTEMPTS=3
ACQUISITION_MAX_RESPONSE_BYTES=5242880
ACQUISITION_CONNECT_TIMEOUT_SECONDS=10
ACQUISITION_READ_TIMEOUT_SECONDS=30
ACQUISITION_TOTAL_TIMEOUT_SECONDS=45
ACQUISITION_MAX_REDIRECTS=3
ACQUISITION_USER_AGENT=EduAILeadAgent/0.1 (+https://github.com/EDLlyc/edu-ai-lead-agent)
ACQUISITION_FIRST_RUN_ITEM_LIMIT=20
ACQUISITION_DAILY_ITEM_LIMIT=10
ACQUISITION_FIRST_RUN_SCAN_LIMIT=100
ACQUISITION_DAILY_SCAN_LIMIT=50
ACQUISITION_FRESHNESS_WINDOW_DAYS=10
ACQUISITION_MAX_RETRY_AFTER_SECONDS=300
ACQUISITION_VERSION=acquisition-v6-broad-hard-tech

# Factual governance — disabled by default until its worker workflow is enabled.
GOVERNANCE_ENABLED=false
GOVERNANCE_SCHEDULER_ENABLED=false
GOVERNANCE_WORKER_ENABLED=false
GOVERNANCE_POLL_SECONDS=5
GOVERNANCE_WORKER_CONCURRENCY=2
GOVERNANCE_LEASE_SECONDS=300
GOVERNANCE_HEARTBEAT_SECONDS=60
GOVERNANCE_MAX_ATTEMPTS=3
GOVERNANCE_RETRY_BASE_SECONDS=30
GOVERNANCE_PIPELINE_VERSION=governance-v1
GOVERNANCE_NORMALIZATION_VERSION=normalization-v1
GOVERNANCE_PASSAGE_SCHEMA_VERSION=passage-v1
GOVERNANCE_TAXONOMY_VERSION=ai-factual-taxonomy-v1
GOVERNANCE_PROMPT_VERSION=factual-analysis-v1
GOVERNANCE_ANALYSIS_SCHEMA_VERSION=factual-analysis-schema-v1
GOVERNANCE_EMBEDDING_INPUT_VERSION=embedding-input-v1
GOVERNANCE_SIMILARITY_RULE_VERSION=semantic-v1
GOVERNANCE_EVENT_ASSIGNMENT_VERSION=event-assignment-v1
# Official LangGraph PostgreSQL saver uses psycopg, not the SQLAlchemy asyncpg URL.
GOVERNANCE_CHECKPOINT_DATABASE_URL=postgresql://edu_ai:edu_ai_local_change_me@127.0.0.1:5432/edu_ai

# Content production — first MVP stage is deterministic daily topic selection.
CONTENT_ENABLED=false
CONTENT_SCHEDULER_ENABLED=false
CONTENT_WORKER_ENABLED=false
CONTENT_SCHEDULE_HOUR=7
CONTENT_SCHEDULE_MINUTE=30
CONTENT_CATCHUP_HOURS=12
CONTENT_POLL_SECONDS=2
CONTENT_WORKER_CONCURRENCY=1
CONTENT_LEASE_SECONDS=120
CONTENT_HEARTBEAT_SECONDS=30
CONTENT_MAX_ATTEMPTS=3
CONTENT_FRESHNESS_WINDOW_DAYS=10
CONTENT_SCORING_VERSION=scoring-v1-preview.11-qualified-authoritative-priority
CONTENT_SCORING_PROFILE=preview
CONTENT_SELECTION_PRIORITY_RULE_VERSION=qualified-authoritative-priority-v1
# Bounded LLM ordering is automatic whenever the content pipeline is enabled.
CONTENT_LLM_RERANK_ENABLED=true
CONTENT_LLM_RERANK_POLICY_VERSION=topic-rerank-v4-minimal-order-contract
CONTENT_LLM_RERANK_CANDIDATE_LIMIT=8
CONTENT_LLM_RERANK_MAX_OUTPUT_TOKENS=1024
# Parallel morning/noon/evening production is separately gated and remains off by default.
CONTENT_SLOT_MODE_ENABLED=false
CONTENT_MORNING_ENABLED=false
CONTENT_NOON_ENABLED=false
CONTENT_EVENING_ENABLED=false
CONTENT_MORNING_TARGET_HOUR=7
CONTENT_MORNING_TARGET_MINUTE=30
CONTENT_NOON_TARGET_HOUR=12
CONTENT_NOON_TARGET_MINUTE=30
CONTENT_EVENING_TARGET_HOUR=18
CONTENT_EVENING_TARGET_MINUTE=30
CONTENT_SLOT_PREPARE_LEAD_MINUTES=90
CONTENT_SLOT_DELIVERY_LATE_MINUTES=60
CONTENT_SLOT_MAX_ITEMS=3
CONTENT_SLOT_RANKING_VERSION=slot-ranking-v1

# Enterprise WeChat self-built application delivery. Disabled by default; the userid and secret
# must stay in a local secret store or a permission-600 deployment .env, never in source control.
WECOM_ENABLED=false
WECOM_API_BASE_URL=https://qyapi.weixin.qq.com
# Keep self_built_app for the existing direct-app route, or use group_webhook for a dedicated group.
WECOM_DELIVERY_PROVIDER=self_built_app
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_CORP_SECRET=
# Bearer credential for the group webhook; keep it only in a local/deployment secret store.
WECOM_GROUP_WEBHOOK_KEY=
WECOM_DEFAULT_RECIPIENT_ID=
WECOM_DEFAULT_RECIPIENT_NAME=销售
WECOM_AUTO_DELIVERY_ENABLED=false
# Keep manual review required by default. Set false only with an explicit direct-delivery rollout.
WECOM_REQUIRE_REVIEW_BEFORE_SEND=true
WECOM_POLL_SECONDS=2
WECOM_WORKER_CONCURRENCY=1
WECOM_LEASE_SECONDS=120
WECOM_HEARTBEAT_SECONDS=30
WECOM_MAX_ATTEMPTS=3
WECOM_REQUEST_TIMEOUT_SECONDS=15
WECOM_MAX_IMAGE_BYTES=10485760
WECOM_MAX_TEXT_BYTES=2048
WECOM_GROUP_MAX_IMAGE_BYTES=2097152
WECOM_GROUP_MAX_TEXT_BYTES=4096
# Database-persisted minimum interval between package starts in one slot lane.
WECOM_SLOT_PACKAGE_GAP_SECONDS=60

# Image generation runs in content-worker; API requests only enqueue idempotent reservations.
IMAGE_ENABLED=false
IMAGE_PROVIDER_MODE=disabled
TOAPIS_BASE_URL=https://toapis.com
TOAPIS_API_KEY=
COMFLY_BASE_URL=https://ai.comfly.org
COMFLY_API_KEY=
# Temporary Comfly image URLs may use any HTTPS host. Each DNS answer is verified as public before
# download; private, loopback, metadata, redirects, oversized files, and invalid image bytes fail.
IMAGE_MODEL=gpt-image-2
IMAGE_PROMPT_VERSION=image-prompt-v1
IMAGE_PIPELINE_VERSION=image-pipeline-v1
IMAGE_MAX_ATTEMPTS=3
IMAGE_POLL_INITIAL_SECONDS=5
IMAGE_POLL_INTERVAL_SECONDS=7
IMAGE_PROVIDER_TIMEOUT_SECONDS=300
IMAGE_PROVIDER_WINDOW_SECONDS=300
IMAGE_MAX_DOWNLOAD_BYTES=20971520
IMAGE_MAX_REQUEST_BYTES=16777216
IMAGE_MAX_PROVIDER_RESPONSE_BYTES=33554432
IMAGE_MAX_REFERENCE_IMAGES=3
IMAGE_REFERENCE_BUDGET_BYTES=6291456
IMAGE_ASSET_MANIFEST=private/brand-materials/visual-assets.manifest.json
IMAGE_SELECTOR_VERSION=brand-visual-selector-v1
IMAGE_SELECTOR_ENABLED=true
# Optional private visual retrieval. Keep disabled for normal tests/builds. Supply endpoint and
# credentials only through a local .env or secret store; never commit exported provider files.
VISUAL_SEMANTIC_ENABLED=false
VISUAL_EMBEDDING_PROVIDER_MODE=disabled
VISUAL_EMBEDDING_ENDPOINT=
VISUAL_EMBEDDING_API_KEY=
VISUAL_EMBEDDING_MODEL=qwen3-vl-embedding
VISUAL_EMBEDDING_DIMENSIONS=2048
VISUAL_EMBEDDING_INPUT_POLICY_VERSION=brand-visual-embedding-input-v2
VISUAL_EMBEDDING_TIMEOUT_SECONDS=60
VISUAL_EMBEDDING_CONCURRENCY=1
VISUAL_INDEX_LEASE_SECONDS=300
# Controlled visual diversity keeps the approved 3D brand style while rotating plans. Leave
# disabled until migration, fake-provider replay/concurrency checks, and a separately approved
# bounded live acceptance have passed. OCR is an independent optional gate; when disabled, the
# generated image text is not machine-verified, while every non-OCR image gate remains required.
IMAGE_DIVERSITY_ENABLED=false
IMAGE_DIVERSITY_POLICY_VERSION=visual-diversity-policy-v1
IMAGE_VISUAL_BRIEF_VERSION=visual-brief-v2-controlled-diversity
IMAGE_DIVERSITY_SELECTOR_VERSION=brand-visual-selector-v2-novelty
IMAGE_DIVERSITY_PROMPT_VERSION=image-prompt-v3-controlled-diversity
IMAGE_DIVERSITY_PIPELINE_VERSION=image-pipeline-v3-controlled-diversity
IMAGE_PERCEPTUAL_HASH_VERSION=image-perceptual-hash-v1
IMAGE_SIMILARITY_POLICY_VERSION=image-similarity-policy-v1
IMAGE_DIVERSITY_HISTORY_DAYS=7
IMAGE_DIVERSITY_HISTORY_LIMIT=400
IMAGE_SIMILARITY_THRESHOLD=6
# The second safe image is accepted with diversity_warning; a third generation is forbidden.
IMAGE_DIVERSITY_MAX_REGENERATIONS=1
IMAGE_OCR_ENABLED=false
# Image OCR uses Zhipu's dedicated layout parser and stays independent from AI_CHAT_MODEL.
IMAGE_OCR_MODEL=glm-ocr
IMAGE_OCR_MAX_INPUT_BYTES=10485760
IMAGE_OCR_MAX_RESPONSE_BYTES=1048576
IMAGE_OCR_TIMEOUT_SECONDS=120
IMAGE_QUALITY_AUDIT_ENABLED=false
IMAGE_REFERENCE_ASSET=private/brand-materials/05-visual-assets/赛先生-显微镜.png

# Shared IP digital asset hub. No authentication exists in MVP: bind it only to localhost or a
# trusted company intranet. Upload/search/download remain provider-free; worker/generation are
# separate opt-ins. The current generation contract is 1:1 (1024x1024) only.
IP_ASSET_HUB_ENABLED=false
IP_ASSET_WORKER_ENABLED=false
IP_ASSET_GENERATION_ENABLED=false
IP_ASSET_RECOGNITION_ENABLED=false
IP_ASSET_RECOGNITION_MODEL=glm-4.1v-thinking-flash
IP_ASSET_RECOGNITION_TIMEOUT_SECONDS=90
IP_ASSET_RECOGNITION_CONCURRENCY=1
IP_ASSET_RECOGNITION_MAX_REQUEST_BYTES=16777216
IP_ASSET_RECOGNITION_MAX_RESPONSE_BYTES=1048576
IP_ASSET_POLL_SECONDS=2
IP_ASSET_WORKER_CONCURRENCY=1
IP_ASSET_LEASE_SECONDS=300
IP_ASSET_HEARTBEAT_SECONDS=60
IP_ASSET_MAX_ATTEMPTS=3
IP_ASSET_UPLOAD_CONCURRENCY=2

BRAND_UPLOAD_MAX_BYTES=26214400
BRAND_PARSE_MAX_PAGES=120
BRAND_PARSE_MAX_CHARACTERS=300000
BRAND_PARSE_MAX_CHUNKS=600
BRAND_CHUNK_CHARACTERS=900
BRAND_CHUNK_OVERLAP_CHARACTERS=120
BRAND_PARSER_VERSION=brand-parser-v3-source-structure
BRAND_CHUNK_VERSION=brand-chunk-v3-parent-child
BRAND_EMBEDDING_INPUT_VERSION=brand-embedding-input-v2-section-context
BRAND_RETRIEVAL_VERSION=brand-hybrid-rrf-v3-parent-diverse
BRAND_OCR_MODEL=glm-ocr
BRAND_OCR_SPARSE_TEXT_THRESHOLD=40
BRAND_OCR_MAX_REQUEST_BYTES=41943040
BRAND_OCR_MAX_RESPONSE_BYTES=10485760
BRAND_OCR_TIMEOUT_SECONDS=180
BRAND_OCR_MAX_PAGES=100

# Factual-analysis provider: disabled (no worker calls), fake (offline acceptance), or zhipu.
# Keep real Zhipu credentials only in local .env or the deployment secret store.
AI_PROVIDER_MODE=disabled
AI_PLATFORM_BASE_URL=
AI_PLATFORM_API_KEY=
AI_CHAT_MODEL=glm-5.2
# Optional one-shot private image catalog annotation model; not used by daily workers.
ZHIPU_VISION_MODEL=glm-4.1v-thinking-flash
AI_EMBEDDING_MODEL=embedding-3
AI_EMBEDDING_DIMENSIONS=2048
AI_CONNECT_TIMEOUT_SECONDS=10
AI_READ_TIMEOUT_SECONDS=120
AI_TOTAL_TIMEOUT_SECONDS=150
AI_PROVIDER_CONCURRENCY=2
AI_MAX_ATTEMPTS=3
AI_MAX_VALIDATION_CORRECTIONS=1
AI_MAX_INPUT_CHARACTERS=40000
AI_MAX_OUTPUT_TOKENS=4096
AI_MAX_TOKENS_PER_RUN=200000
AI_MAX_TOKENS_PER_DAY=1000000
AI_MAX_COST_UNITS_PER_RUN=100000
AI_MAX_COST_UNITS_PER_DAY=500000

# Local official-account article simulation. Disabled in the default stack and all default tests.
# Fixture mode is provider-free. Live mode reuses only the server-side Zhipu settings above.
# Multimodal body matching is an independent live-only opt-in and remains disabled by default.
OFFICIAL_ACCOUNT_LOCAL_ENABLED=false
OFFICIAL_ACCOUNT_EDITOR_HANDOFF_ENABLED=false
OFFICIAL_ACCOUNT_LOCAL_WORKER_ENABLED=false
OFFICIAL_ACCOUNT_LOCAL_POLL_SECONDS=2
OFFICIAL_ACCOUNT_LOCAL_WORKER_CONCURRENCY=1
OFFICIAL_ACCOUNT_LOCAL_LEASE_SECONDS=300
OFFICIAL_ACCOUNT_LOCAL_HEARTBEAT_SECONDS=60
OFFICIAL_ACCOUNT_LOCAL_MAX_ATTEMPTS=3
OFFICIAL_ACCOUNT_LOCAL_RETRY_BASE_SECONDS=10
OFFICIAL_ACCOUNT_LOCAL_GENERATOR_PROMPT_VERSION=official-account-generator-v7-five-to-seven-sections
OFFICIAL_ACCOUNT_LOCAL_ARTICLE_SCHEMA_VERSION=official-account-article-schema-v5-news-context
OFFICIAL_ACCOUNT_LOCAL_MEDIA_PLAN_VERSION=official-account-media-plan-v4-five-blocks
OFFICIAL_ACCOUNT_LOCAL_AUDITOR_PROMPT_VERSION=official-account-auditor-v2-structured-output
OFFICIAL_ACCOUNT_LOCAL_AUDIT_SCHEMA_VERSION=official-account-audit-schema-v1
OFFICIAL_ACCOUNT_LOCAL_RULE_VERSION=official-account-rules-v4-reader-copy
OFFICIAL_ACCOUNT_LOCAL_RENDERER_VERSION=wechat-html-renderer-v8-news-context
OFFICIAL_ACCOUNT_LOCAL_STYLE_VERSION=wechat-inline-science-field-guide-v8-news-context
OFFICIAL_ACCOUNT_LOCAL_TEMPLATE_VERSION=wechat-science-field-guide-template-v8-news-context
OFFICIAL_ACCOUNT_LOCAL_ADAPTER_VERSION=official-account-local-adapter-v7-disjoint-attempt-ordinals
OFFICIAL_ACCOUNT_LOCAL_VISUAL_QUERY_VERSION=official-account-visual-query-v1
OFFICIAL_ACCOUNT_LOCAL_VISUAL_SELECTOR_VERSION=official-account-visual-selector-v3-multimodal-hybrid
OFFICIAL_ACCOUNT_LOCAL_CONTEXT_MEDIA_PLAN_VERSION=official-account-news-context-selection-v1
OFFICIAL_ACCOUNT_LOCAL_VISUAL_SEMANTIC_ENABLED=false
# Optional live-only original body illustrations. This remains off for fixture/demo/tests. When
# enabled it reuses the selected approved IP reference, requires IMAGE_* settings and exactly one
# image provider attempt; it never calls WeChat or auto-publishes.
OFFICIAL_ACCOUNT_LOCAL_GENERATED_VISUALS_ENABLED=false
OFFICIAL_ACCOUNT_LOCAL_GENERATED_VISUAL_PLAN_VERSION=official-account-generated-visual-plan-v3-visible-ip
OFFICIAL_ACCOUNT_LOCAL_GENERATED_VISUAL_PROMPT_VERSION=official-account-generated-visual-prompt-v3-visible-ip-block-scene
OFFICIAL_ACCOUNT_LOCAL_DEFAULT_AUTHOR=赛先生
OFFICIAL_ACCOUNT_LOCAL_MIN_CHARACTERS=1200
OFFICIAL_ACCOUNT_LOCAL_TARGET_MIN_CHARACTERS=1800
OFFICIAL_ACCOUNT_LOCAL_TARGET_MAX_CHARACTERS=2600
OFFICIAL_ACCOUNT_LOCAL_MAX_CHARACTERS=4000
OFFICIAL_ACCOUNT_LOCAL_MAX_OUTPUT_TOKENS=16384
OFFICIAL_ACCOUNT_LOCAL_AUDIT_MAX_OUTPUT_TOKENS=2048

# Local-only Agent research workbench. The independent ASGI app stays disabled by default and
# must be bound to 127.0.0.1. Production rejects enablement; the default fixture/deterministic
# modes require no database, provider key, or network call.
AGENT_WORKBENCH_ENABLED=false
AGENT_WORKBENCH_DATA_MODE=fixture
AGENT_WORKBENCH_MODEL_MODE=deterministic
AGENT_WORKBENCH_LIVE_ENABLED=false
# Optional explicit local live mode only; leave these blank for tests and the portfolio baseline.
AGENT_WORKBENCH_OPENAI_BASE_URL=
AGENT_WORKBENCH_OPENAI_API_KEY=
AGENT_WORKBENCH_OPENAI_MODEL=glm-5.2
